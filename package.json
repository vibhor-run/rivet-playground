{
  "name": "rivet-playground",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "RIVETKIT_STORAGE_PATH=\"$PWD/.local\" bun run --cwd apps/runner dev",
    "counter": "bun run --cwd apps/runner counter",
    "identity": "bun run --cwd apps/runner identity",
    "read": "bun run --cwd apps/runner read",
    "destruction": "bun run --cwd apps/runner destruction",
    "events": "bun run --cwd apps/runner events",
    "check-types": "tsc --noEmit",
    "errors": "bun run --cwd apps/runner errors",
    "simultaneous": "bun run --cwd apps/runner simultaneous",
    "overlap": "bun run --cwd apps/runner overlap",
    "wait-first": "bun run --cwd apps/runner wait-first",
    "queues": "bun run --cwd apps/runner queues",
    "queue-crash": "bun run --cwd apps/runner queue-crash",
    "workflow": "bun run --cwd apps/runner workflow",
    "workflow-recovery": "bun run --cwd apps/runner workflow-recovery",
    "workflow-effect": "bun run --cwd apps/runner workflow-effect",
    "workflow-idempotent": "bun run --cwd apps/runner workflow-idempotent",
    "cron": "bun run --cwd apps/runner cron",
    "cron-sleep": "bun run --cwd apps/runner cron-sleep",
    "auth": "bun run --cwd apps/runner auth",
    "actor-call": "bun run --cwd apps/runner actor-call"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "rivetkit": "2.3.17",
      "@rivetkit/engine-cli": "2.3.17",
      "@rivetkit/workflow-engine": "2.3.17"
    }
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
